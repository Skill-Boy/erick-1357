# Entorno de ejecución del backend. Usa production al desplegar.
NODE_ENV=development

# Puerto expuesto por Express. El frontend lo usará como destino del proxy de desarrollo.
BACKEND_PORT=3001

# Puerto del servidor Vite durante desarrollo.
FRONTEND_PORT=5173

# Datos ficticios de la pasarela SnailPay.
# La tarjeta aprobada requiere vencimiento
SUCCESS_CARD=

# Fecha de vencimiento ficticia requerida para aprobar la tarjeta configurada.
EXPIRATION_DATE_CARD=

# CVV ficticio requerido para aprobar la tarjeta configurada.
CVV_DATE=

# Esta tarjeta siempre simula una falla interna de SnailPay.
SYSTEM_ERROR_CARD=0000000000000000

# Importe máximo aprobable para la tarjeta configurada.
SUCCESS_CARD_AVAILABLE_BALANCE=