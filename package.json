{
  "name": "erick-1357",
  "version": "1.0.0",
  "private": true,
  "description": "Proyecto fullstack TypeScript con Express (arquitectura por servicios) y React",
  "workspaces": [
    "src/backend",
    "src/frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --workspace=src/backend run dev",
    "dev:frontend": "npm --workspace=src/frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --workspace=src/backend run build",
    "build:frontend": "npm --workspace=src/frontend run build",
    "start:backend": "npm --workspace=src/backend run start",
    "test": "npm --workspace=src/backend run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
